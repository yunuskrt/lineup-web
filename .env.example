# Copy to .env.local. NEXT_PUBLIC_ values ship in the browser bundle:
# never put a secret here. Restart `npm run dev` after a change.

# mock (default): in-memory adapter, no backend needed
# real: talk to the NestJS backend at NEXT_PUBLIC_API_URL
NEXT_PUBLIC_API_MODE=mock

# The backend's origin, no trailing slash. Required in real mode;
# https in production. Open the app on localhost:3000, not 127.0.0.1,
# or the backend's CORS and origin check refuse it.
NEXT_PUBLIC_API_URL=http://localhost:8080
